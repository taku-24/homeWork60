@model WebApplication7.Models.ToDoTask

<h2>Редактировать задачу</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label>Название задачи</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Приоритет</label>
        <select asp-for="Priority" class="form-control" asp-items="Html.GetEnumSelectList<WebApplication7.Models.Priority>()"></select>
        <span asp-validation-for="Priority" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Описание задачи</label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-2">Сохранить</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Отмена</a>
</form>

@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
